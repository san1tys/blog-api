BLOG_ENV_ID=local
BLOG_SECRET_KEY=dev-secret-key-change-me-please-32chars-min
BLOG_DEBUG=True
BLOG_ALLOWED_HOSTS=127.0.0.1,localhost
BLOG_REDIS_URL=redis://127.0.0.1:6379/1
BLOG_CELERY_BROKER_URL=redis://127.0.0.1:6379/2
BLOG_CELERY_RESULT_BACKEND_URL=redis://127.0.0.1:6379/3

# Flower monitoring UI — basic auth (user:password)
FLOWER_BASIC_AUTH=admin:change-me

# Set to 1 to seed demo data on container startup
BLOG_SEED_DB=0

# Required only when BLOG_ENV_ID=prod (PostgreSQL)
BLOG_DB_NAME=blog_db
BLOG_DB_USER=postgres
BLOG_DB_PASSWORD=change-me
BLOG_DB_HOST=localhost
BLOG_DB_PORT=5432
